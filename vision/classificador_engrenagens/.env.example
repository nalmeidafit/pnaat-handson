# Copie este arquivo para .env na Raspberry Pi da bancada:
#   cp .env.example .env
#
# Depois edite a senha e carregue as variáveis no terminal com:
#   set -a
#   source .env
#   set +a
#
# O arquivo .env é ignorado pelo Git e deve permanecer somente na bancada.
# Proteja-o com: chmod 600 .env

PNAAT_MQTT_HOST=127.0.0.1
PNAAT_MQTT_PORT=1883
PNAAT_MQTT_USERNAME=pnaat
PNAAT_MQTT_PASSWORD='TROQUE_ESTA_SENHA'
PNAAT_TOPIC_PREFIX=pnaat
PNAAT_MODEL_PATH=./best.pt
